  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000",
      "type": "string",
      "description": "Base URL for the Rule Studio backend API"
    }
  ],
  "auth": {
    "type": "noauth"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Pre-request script to set up environment",
          "console.log('Starting DEMS simulation request...');",
          "pm.environment.set('request_timestamp', new Date().toISOString());"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Test script to validate simulation responses",
          "pm.test('Status code is 200 or 500', function () {",
          "    pm.expect(pm.response.code).to.be.oneOf([200, 500]);",
          "});",
          "",
          "if (pm.response.code === 200) {",
          "    pm.test('Response has simulation result structure', function () {",
          "        const jsonData = pm.response.json();",
          "        pm.expect(jsonData).to.have.property('totalMessages');",
          "        pm.expect(jsonData).to.have.property('sentMessages');",
          "        pm.expect(jsonData).to.have.property('deliveredMessages');",
          "        pm.expect(jsonData).to.have.property('failedMessages');",
          "        pm.expect(jsonData).to.have.property('simulationDuration');",
          "        pm.expect(jsonData).to.have.property('deliveryTracker');",
          "    });",
          "    ",
          "    pm.test('Delivery tracker is an array', function () {",
          "        const jsonData = pm.response.json();",
          "        pm.expect(jsonData.deliveryTracker).to.be.an('array');",
          "    });",
          "    ",
          "    pm.test('All messages have valid status', function () {",
          "        const jsonData = pm.response.json();",
          "        const validStatuses = ['pending', 'sent', 'delivered', 'failed'];",
          "        jsonData.deliveryTracker.forEach(function(message) {",
          "            pm.expect(validStatuses).to.include(message.status);",
          "        });",
          "    });",
          "    ",
          "    console.log('Simulation completed in:', pm.response.json().simulationDuration, 'ms');",
          "}"
        ]
      }
    }
  ]
