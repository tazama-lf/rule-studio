    },
    "GET /rules/api/global-variables/:ruleId": {
      "tier2": {
        "description": "Retrieves the global variables used in a specific rule editor",
        "rolePermissions": {
          "editor": {
            "allowedCurrentStatuses": [
              "STATUS_01_IN_PROGRESS",
              "STATUS_02_ON_HOLD",
              "STATUS_03_UNDER_REVIEW",
              "STATUS_04_APPROVED",
              "STATUS_05_REJECTED",
              "STATUS_08_DEPLOYED"
            ]
