        "rolePermissions": {
          "editor": {
            "allowedCurrentStatuses": [
              "STATUS_01_IN_PROGRESS"
            ]
          }
        }
      }
    },
    "GET /rules/api/:ruleId/flow/status": {
      "tier2": {
